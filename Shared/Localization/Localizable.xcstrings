    "Se o sistema permitir, o pedido aparece agora. Se não, você pode avaliar depois em Configurações." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das System es zulässt, erscheint die Anfrage jetzt. Wenn nicht, kannst du später in den Einstellungen bewerten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the system allows it, the prompt appears now. If not, you can rate later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el sistema lo permite, la solicitud aparece ahora. Si no, puedes valorar más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le système le permet, la demande apparaît maintenant. Sinon, vous pourrez noter plus tard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il sistema lo consente, la richiesta appare ora. Altrimenti potrai valutare più tardi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムが許可すれば、評価の案内が今表示されます。表示されなくても、あとで設定から評価できます。"
          }
        }
      }
    },
    "Se quiser, posso sugerir outras receitas com base na sua despensa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie möchten, kann ich andere Rezepte basierend auf Ihrer Vorratskammer vorschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want, I can suggest other recipes based on your pantry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres, puedo sugerirte otras recetas según tu despensa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous le souhaitez, je peux suggérer d'autres recettes selon votre garde-manger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuoi, posso suggerire altre ricette in base alla tua dispensa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしければ、パントリーに基づいて他のレシピを提案できます。"
          }
        }
      }
    },
