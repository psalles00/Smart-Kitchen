          "stringUnit": {
            "state": "translated",
            "value": "%@ expire aujourd'hui !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft heute ab!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scade oggi!"
          }
        }
      }
    },
