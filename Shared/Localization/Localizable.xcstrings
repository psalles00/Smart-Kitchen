    "%@ serão afetadas por essa remoção.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be affected by this removal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se verán afectadas por esta eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront concernées par cette suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ werden von dieser Entfernung betroffen sein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saranno interessate da questa rimozione."
          }
        }
      }
    },
    "%@ vence amanhã. Hora de usar ou repor!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expires tomorrow. Time to use it or restock!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence mañana. ¡Hora de usarlo o reponerlo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expire demain. C'est le moment de l'utiliser ou de le remplacer !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft morgen ab. Zeit zu verbrauchen oder nachzukaufen!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scade domani. È ora di usarlo o ricomprarlo!"
          }
        }
      }
    },
    "%@ vence em %lld dias. Fique de olho!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expires in %lld days. Keep an eye on it!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence en %lld días. ¡Mantente atento!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expire dans %lld jours. Restez attentif !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft in %lld Tagen ab. Behalten Sie es im Auge!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scade tra %lld giorni. Tienilo d'occhio!"
          }
        }
      }
    },
    "%@ vence hoje!": {
      "extractionState": "manual",
      "localizations": {
