    "Cozinhe em fogo médio, mexendo sem parar, até a massa desgrudar do fundo da panela.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook over medium heat, stirring constantly, until the mixture pulls away from the bottom of the pan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina a fuego medio, removiendo sin parar, hasta que la masa se despegue del fondo de la cacerola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire à feu moyen en remuant sans cesse, jusqu'à ce que la pâte se détache du fond de la casserole."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei mittlerer Hitze unter ständigem Rühren kochen, bis sich die Masse vom Topfboden löst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuocere a fuoco medio, mescolando continuamente, fino a quando l'impasto si stacca dal fondo della pentola."
          }
        }
      }
    },
