    "Lista os alimentos registrados neste dia, agrupados por refeição (café, almoço, lanche e jantar). Use o + para registrar um novo alimento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet die an diesem Tag protokollierten Lebensmittel auf, gruppiert nach Mahlzeit (Frühstück, Mittagessen, Snack und Abendessen). Tippen Sie auf +, um ein neues Lebensmittel zu protokollieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists foods logged on this day, grouped by meal (breakfast, lunch, snack and dinner). Use + to log a new food."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista los alimentos registrados este día, agrupados por comida (desayuno, almuerzo, merienda y cena). Usa + para registrar un alimento nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste les aliments enregistrés ce jour, regroupés par repas (petit-déjeuner, déjeuner, encas et dîner). Utilisez + pour enregistrer un nouvel aliment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca gli alimenti registrati in questo giorno, raggruppati per pasto (colazione, pranzo, spuntino e cena). Usa + per registrare un nuovo alimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日に記録された食品を、食事（朝食・昼食・間食・夕食）ごとにまとめて表示します。+ で新しい食品を記録できます。"
          }
        }
      }
    },
