    "Os contadores simulados preservam os reais. Requisições de IA continuam usando o serviço real." : {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os contadores simulados preservam os reais. Requisições de IA continuam usando o serviço real."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulated counters preserve actual usage. AI requests still use the real service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contadores simulados conservan el uso real. Las solicitudes de IA siguen usando el servicio real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compteurs simulés préservent les utilisations réelles. Les requêtes IA utilisent toujours le service réel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulierte Zähler bewahren die tatsächliche Nutzung. KI-Anfragen nutzen weiterhin den echten Dienst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contatori simulati preservano gli utilizzi reali. Le richieste IA continuano a usare il servizio reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレーションのカウンターは実際の利用回数を保持します。AIリクエストは実際のサービスを使用します。"
          }
        }
      }
    },
