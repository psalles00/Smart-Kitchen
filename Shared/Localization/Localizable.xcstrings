    "Suco estimado sem diluição. Medidas caseiras são aproximadas; revise a quantidade e o preparo." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Juice estimated without dilution. Household measures are approximate; review the quantity and preparation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suco estimado sem diluição. Medidas caseiras são aproximadas; revise a quantidade e o preparo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zumo estimado sin diluir. Las medidas caseras son aproximadas; revisa la cantidad y la preparación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jus estimé sans dilution. Les mesures ménagères sont approximatives ; vérifiez la quantité et la préparation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saft ohne Verdünnung geschätzt. Haushaltsmaße sind ungefähre Angaben; Menge und Zubereitung prüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Succo stimato senza diluizione. Le misure casalinghe sono approssimative; controlla quantità e preparazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希釈していない果汁として推定しています。家庭用の計量は概算です。量と作り方を確認してください。"
          }
        }
      }
    },
