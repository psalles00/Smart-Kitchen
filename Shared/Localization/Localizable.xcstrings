    "Alterações feitas em um dispositivo aparecerão nos outros em alguns instantes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes made on one device will appear on the others within moments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios hechos en un dispositivo aparecerán en los otros en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications effectuées sur un appareil apparaîtront sur les autres dans quelques instants."
