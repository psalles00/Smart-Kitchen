        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about recipes, manage your pantry, or discover what to cook with what you have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta por recetas, gestiona tu despensa o descubre qué cocinar con lo que tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions sur les recettes, gérez votre garde-manger ou découvrez quoi cuisiner avec ce que vous avez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie Fragen zu Rezepten, verwalten Sie Ihre Vorratskammer oder entdecken Sie, was Sie mit dem kochen können, was Sie haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi informazioni sulle ricette, gestisci la tua dispensa o scopri cosa cucinare con ciò che hai."
