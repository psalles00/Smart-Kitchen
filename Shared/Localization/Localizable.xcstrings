    "Cozinhe em fogo baixo mexendo até desgrudar do fundo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei niedriger Hitze unter Rühren kochen, bis es sich vom Boden löst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook on low heat, stirring until it pulls from the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocina a fuego lento removiendo hasta que se despegue del fondo."
          }
