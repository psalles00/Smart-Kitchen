    "Receitas compatíveis com o que você tem na despensa, priorizando o horário do dia. Ajuste o nível de compatibilidade nas configurações ou filtre por categoria abaixo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezepte, die zu Ihren Vorräten passen, mit Priorität auf der aktuellen Tageszeit. Passen Sie die Übereinstimmung in den Einstellungen an oder filtern Sie unten nach Kategorie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipes compatible with your pantry, prioritized for the current time of day. Adjust the compatibility level in settings or filter by category below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recetas compatibles con tu despensa, priorizando la hora del día. Ajusta el nivel de compatibilidad en los ajustes o filtra por categoría abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recettes compatibles avec votre garde-manger, priorisées selon l'heure de la journée. Ajustez le niveau de compatibilité dans les réglages ou filtrez par catégorie ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricette compatibili con la tua dispensa, con priorità all'orario della giornata. Regola il livello di compatibilità nelle impostazioni o filtra per categoria qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パントリーの内容に合うレシピを、現在の時間帯を優先して表示します。互換性レベルは設定で調整するか、下のカテゴリで絞り込めます。"
          }
        }
      }
    },
