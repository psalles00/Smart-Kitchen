    "Apagar os dados do iCloud só está disponível em um device físico com suporte a CloudKit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting iCloud data is only available on a physical device with CloudKit support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar los datos de iCloud solo está disponible en un dispositivo físico compatible con CloudKit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effacement des données iCloud n'est disponible que sur un appareil physique compatible CloudKit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der iCloud-Daten ist nur auf einem physischen Gerät mit CloudKit-Unterstützung verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione dei dati iCloud è disponibile solo su un dispositivo fisico con supporto CloudKit."
          }
        }
