    "Não foi possível abrir o banco local. O app iniciou em modo temporário; reinicie e tente novamente.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the local database. The app started in temporary mode; restart and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la base de datos local. La app se inició en modo temporal; reinicia e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir la base de données locale. L'app a démarré en mode temporaire ; redémarrez et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datenbank konnte nicht geöffnet werden. Die App wurde im temporären Modus gestartet; bitte neu starten und erneut versuchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il database locale. L'app è stata avviata in modalità temporanea; riavvia e riprova."
          }
        }
      }
    },
