    "Todos os participantes perderão acesso aos dados compartilhados. Seus dados locais serão mantidos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All participants will lose access to the shared data. Your local data will be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los participantes perderán acceso a los datos compartidos. Tus datos locales se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les participants perdront l'accès aux données partagées. Vos données locales seront conservées."
          }
        }
      }
    },
