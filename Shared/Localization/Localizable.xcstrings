            "value" : "Según el promedio de tus días completados, estás consumiendo cerca de"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon la moyenne de vos journées terminées, vous consommez environ"
          }
        },
        "it" : {
          "stringUnit" : {
