    "Isso apagará as metas, overrides e preferências do perfil atual. Seus registros de refeições e peso permanecem intactos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will erase the goals, overrides, and preferences of the current profile. Your meal and weight entries will remain intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará las metas, anulaciones y preferencias del perfil actual. Tus registros de comidas y peso permanecerán intactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera les objectifs, surcharges et préférences du profil actuel. Vos enregistrements de repas et de poids resteront intacts."
          }
        }
      }
    },
    "Isso apagará receitas, listas, categorias, histórico da IA, backups internos e os dados sincronizados no iCloud deste app. A ação é irreversível.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete recipes, lists, categories, AI history, internal backups, and the data synced in this app's iCloud. This action is irreversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará recetas, listas, categorías, historial de la IA, copias internas y los datos sincronizados en iCloud de esta app. Esta acción es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela effacera les recettes, listes, catégories, historique de l'IA, sauvegardes internes et les données synchronisées sur iCloud de cette app. L'action est irréversible."
          }
        }
      }
    },
