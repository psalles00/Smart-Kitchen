    "Cole o link de qualquer site, blog ou rede social. Vamos extrair o que der.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link from any site, blog, or social network. We'll extract what we can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el enlace de cualquier sitio, blog o red social. Extraeremos lo que se pueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le lien de n'importe quel site, blog ou réseau social. Nous extrairons ce que nous pourrons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Link einer beliebigen Website, eines Blogs oder eines sozialen Netzwerks ein. Wir extrahieren, was wir können."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il link di qualsiasi sito, blog o social network. Estrarremo ciò che possiamo."
          }
        }
      }
    },
    "Cole um link, envie uma foto, use a câmera ou texto — nós estruturamos em uma receita editável.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link, send a photo, use the camera, or text — we'll structure it into an editable recipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace, envía una foto, usa la cámara o el texto — lo estructuramos en una receta editable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien, envoyez une photo, utilisez l'appareil photo ou du texte — nous le structurerons en recette modifiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Link ein, senden Sie ein Foto, verwenden Sie die Kamera oder Text — wir strukturieren es in ein bearbeitbares Rezept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un link, invia una foto, usa la fotocamera o un testo — strutturiamo tutto in una ricetta modificabile."
          }
        }
      }
    },
