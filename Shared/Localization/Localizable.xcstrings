    "Em outra tigela, bata os ovos com o leite e a manteiga derretida." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer anderen Schüssel die Eier mit der Milch und der geschmolzenen Butter verquirlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In another bowl, whisk the eggs with the milk and melted butter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En otro bol, bate los huevos con la leche y la mantequilla derretida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un autre saladier, battez les œufs avec le lait et le beurre fondu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un'altra ciotola, sbattere le uova con il latte e il burro fuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のボウルで、卵を牛乳と溶かしバターと一緒に泡立てます。"
          }
        }
      }
    },
    "Em outra, bata os ovos com leite e manteiga derretida." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer anderen Eier mit Milch und geschmolzener Butter verquirlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In another, whisk eggs with milk and melted butter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En otro, bate los huevos con leche y mantequilla derretida."
          }
        },
        "fr" : {
          "stringUnit" : {
