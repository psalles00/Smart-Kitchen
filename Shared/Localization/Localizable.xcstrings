    "As prévias não salvam escolhas, enviam respostas ou realizam compras." : {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As prévias não salvam escolhas, enviam respostas ou realizam compras."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews do not save choices, submit responses, or make purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas no guardan opciones, envían respuestas ni realizan compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus ne sauvegardent pas les choix, ne transmettent pas de réponses et ne réalisent aucun achat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschauen speichern keine Auswahl, senden keine Antworten und tätigen keine Käufe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anteprime non salvano scelte, inviano risposte o effettuano acquisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューでは選択の保存、回答の送信、購入は行いません。"
          }
        }
      }
    },
