    "Você começou estes dias e ainda não concluiu — eles não entram na sua média até serem concluídos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You started these days and haven't finished them — they don't count toward your average until completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezaste estos días y aún no los has completado — no cuentan para tu promedio hasta que se completen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez commencé ces journées et ne les avez pas encore terminées — elles ne comptent pas dans votre moyenne tant qu'elles ne sont pas terminées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben diese Tage begonnen und noch nicht abgeschlossen — sie zählen erst nach Abschluss in Ihren Durchschnitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai iniziato questi giorni ma non li hai ancora completati — non entrano nella tua media finché non vengono completati."
          }
        }
      }
    },
