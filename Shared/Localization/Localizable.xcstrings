    "Conclua mais dias para eu montar uma média mais estável e confiável.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete more days so I can build a more stable and reliable average."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa más días para que pueda calcular un promedio más estable y fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez plus de journées pour que je puisse calculer une moyenne plus stable et fiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie weitere Tage ab, damit ich einen stabileren und zuverlässigeren Durchschnitt erstellen kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa più giorni per permettermi di costruire una media più stabile e affidabile."
          }
        }
      }
    },
    "Conclua pelo menos um dia para eu calcular uma média e te mostrar uma leitura mais fiel do seu progresso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete at least one day so I can calculate an average and show you a more accurate view of your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa al menos un día para que pueda calcular un promedio y mostrarte una lectura más fiel de tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez au moins une journée pour que je puisse calculer une moyenne et vous montrer une lecture plus fidèle de votre progression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie mindestens einen Tag ab, damit ich einen Durchschnitt berechnen und Ihnen eine genauere Darstellung Ihres Fortschritts zeigen kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa almeno un giorno per permettermi di calcolare una media e mostrarti una lettura più fedele dei tuoi progressi."
          }
        }
      }
    },
