    "Podemos transcrever o áudio do vídeo e montar uma receita editável antes de salvar. O limite é de %lld minutos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can transcribe the video's audio and build an editable recipe before saving. The limit is %lld minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos transcribir el audio del vídeo y montar una receta editable antes de guardar. El límite es de %lld minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous pouvons transcrire l'audio de la vidéo et créer une recette modifiable avant l'enregistrement. La limite est de %lld minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir können das Video-Audio transkribieren und ein bearbeitbares Rezept vor dem Speichern erstellen. Das Limit beträgt %lld Minuten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiamo trascrivere l'audio del video e creare una ricetta modificabile prima di salvare. Il limite è di %lld minuti."
          }
        }
      }
    },
