    "Pode ser bagunçado. Nossa IA organiza em ingredientes e passos." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann unordentlich sein. Unsere KI organisiert es in Zutaten und Schritte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can be messy. Our AI organizes it into ingredients and steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ser desordenado. Nuestra IA lo organiza en ingredientes y pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut être désordonné. Notre IA l'organise en ingrédients et étapes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può essere disordinato. La nostra IA organizza in ingredienti e passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雑然としていても大丈夫。AI が材料と手順に整理します。"
          }
        }
      }
    },
    "Podemos transcrever o áudio do vídeo e montar uma receita editável antes de salvar. O limite é de %lld minutos." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir können das Video-Audio transkribieren und ein bearbeitbares Rezept vor dem Speichern erstellen. Das Limit beträgt %lld Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We can transcribe the video's audio and build an editable recipe before saving. The limit is %lld minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podemos transcribir el audio del vídeo y montar una receta editable antes de guardar. El límite es de %lld minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
