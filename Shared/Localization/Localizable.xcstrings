    "A simulação não realiza compras nem altera sua assinatura na App Store." : {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulação não realiza compras nem altera sua assinatura na App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulation does not make purchases or change your App Store subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulación no realiza compras ni cambia tu suscripción en la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulation ne réalise aucun achat et ne modifie pas votre abonnement App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Simulation tätigt keine Käufe und ändert dein App-Store-Abo nicht."
