// Secrets.example.xcconfig
//
// Copy this file to `Secrets.xcconfig` (same folder) and fill in real keys.
// `Secrets.xcconfig` is gitignored. The build system substitutes these values
// into Info.plist at build time, and `APIConfig.swift` reads them at runtime.
//
// IMPORTANT: do NOT commit `Secrets.xcconfig`.

// OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY = sk-proj-PUT-YOUR-KEY-HERE

// OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY = sk-or-v1-PUT-YOUR-KEY-HERE
